<mxfile host="app.diagrams.net" modified="2026-10-06T08:20:03+00:00" agent="Codex" version="24.7.17" type="device" compressed="false"><diagram id="full-path-sample" name="全経路確認の作例"><mxGraphModel dx="1580" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="全経路確認の図示例｜依頼処理と失敗後の再実行" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#17365D;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="55" as="geometry" /></mxCell><mxCell id="req" value="&lt;b&gt;元の要求（架空）&lt;/b&gt;&lt;br&gt;R1 有効な依頼を処理し、結果を示す。　R2 処理失敗時は許可内で修正し、上限内で同じ依頼を再実行する。&lt;br&gt;R3 入力不備・実行不可・修正不能・上限到達では、理由を示して停止する。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F4F6F8;strokeColor=#A8B5C3;strokeWidth=1;fontColor=#263645;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="1520" height="86" as="geometry" /></mxCell><mxCell id="section1" value="正常時：開始 → 受付 → 可否確認 → 処理 → 結果確認 → 完了" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#53677D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="207" width="1480" height="28" as="geometry" /></mxCell><mxCell id="start" value="利用者が依頼" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E5F5E8;strokeColor=#35884A;strokeWidth=2;fontColor=#245C32;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="150" height="76" as="geometry" /></mxCell><mxCell id="f1" value="&lt;b&gt;F1 受付&lt;/b&gt;&lt;br&gt;入力：依頼・対象ID&lt;br&gt;出力：受付結果" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF3FF;strokeColor=#2D6CB3;strokeWidth=2;fontColor=#17365D;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="240" y="275" width="210" height="96" as="geometry" /></mxCell><mxCell id="f2" value="&lt;b&gt;F2 実行可否の確認&lt;/b&gt;&lt;br&gt;入力：依頼・許可条件&lt;br&gt;出力：可否・理由" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF3FF;strokeColor=#2D6CB3;strokeWidth=2;fontColor=#17365D;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="275" width="220" height="96" as="geometry" /></mxCell><mxCell id="f3" value="&lt;b&gt;F3 処理&lt;/b&gt;&lt;br&gt;入力：同じ依頼・対象ID&lt;br&gt;出力：結果／失敗理由" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF3FF;strokeColor=#2D6CB3;strokeWidth=2;fontColor=#17365D;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="275" width="220" height="96" as="geometry" /></mxCell><mxCell id="f4" value="&lt;b&gt;F4 結果の確認&lt;/b&gt;&lt;br&gt;入力：結果・証拠&lt;br&gt;出力：適合／不適合" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF3FF;strokeColor=#2D6CB3;strokeWidth=2;fontColor=#17365D;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="1100" y="275" width="210" height="96" as="geometry" /></mxCell><mxCell id="ok" value="結果を提示&lt;br&gt;完了" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DDF5E5;strokeColor=#28854B;strokeWidth=2;fontColor=#1F5E36;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1380" y="285" width="170" height="76" as="geometry" /></mxCell><mxCell id="badinput" value="入力不備の理由を表示&lt;br&gt;停止" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FDE9E7;strokeColor=#C5574C;strokeWidth=2;fontColor=#752F2A;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="245" y="565" width="205" height="86" as="geometry" /></mxCell><mxCell id="notallowed" value="実行不可の理由を表示&lt;br&gt;停止" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FDE9E7;strokeColor=#C5574C;strokeWidth=2;fontColor=#752F2A;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="525" y="565" width="210" height="86" as="geometry" /></mxCell><mxCell id="f5" value="&lt;b&gt;F5 修正可否・再実行上限&lt;/b&gt;&lt;br&gt;入力：失敗理由・試行回数&lt;br&gt;出力：可否・理由" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B28A00;strokeWidth=2;fontColor=#5C4700;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="810" y="565" width="220" height="112" as="geometry" /></mxCell><mxCell id="no-repair" value="理由を表示して停止&lt;br&gt;修正不能・上限到達・修正失敗" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FDE9E7;strokeColor=#C5574C;strokeWidth=2;fontColor=#752F2A;fontSize=14;spacing=6;" vertex="1" parent="1"><mxGeometry x="1170" y="795" width="280" height="96" as="geometry" /></mxCell><mxCell id="f6" value="&lt;b&gt;F6 許可内の修正&lt;/b&gt;&lt;br&gt;入力：同じ依頼・修正対象&lt;br&gt;出力：修正結果" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#EAF3FF;strokeColor=#2D6CB3;strokeWidth=2;fontColor=#17365D;fontSize=15;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="790" width="220" height="100" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;レビューの視点&lt;/b&gt;　元の要求R1～R3を起点に、各機能の入力・出力、分岐条件、行き先、終了状態をたどる。&lt;br&gt;F3の失敗を直ちに停止へつなぐだけでは、図が閉じていてもR2の修正・同一依頼での再実行が欠落する。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#F4F6F8;strokeColor=#A8B5C3;strokeWidth=1;fontColor=#263645;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="1520" height="82" as="geometry" /></mxCell><mxCell id="e01" value="依頼" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#657B90;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="start" target="f1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e02" value="受理" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#657B90;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e03" value="不備" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#C5574C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f1" target="badinput"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e04" value="実行可" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#657B90;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e05" value="実行不可" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#C5574C;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f2" target="notallowed"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e06" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#657B90;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e07" value="処理失敗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#B28A00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f3" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e08" value="適合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#28854B;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f4" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e09" value="不適合" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#B28A00;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1205" y="485" /><mxPoint x="1065" y="485" /><mxPoint x="1065" y="621" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell><mxCell id="e10" value="修正不可・上限到達" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#C5574C;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="f5" target="no-repair"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="621" /><mxPoint x="1310" y="621" /><mxPoint x="1310" y="775" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell><mxCell id="e11" value="修正可能" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#B28A00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="同じ依頼で再確認" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#B28A00;exitX=0;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="f6" target="f2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="840" /><mxPoint x="475" y="420" /><mxPoint x="575" y="420" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell><mxCell id="e13" value="修正失敗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#31465B;labelBackgroundColor=#FFFFFF;strokeColor=#C5574C;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="f6" target="no-repair"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="840" /></Array><mxPoint x="0" y="-12" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>